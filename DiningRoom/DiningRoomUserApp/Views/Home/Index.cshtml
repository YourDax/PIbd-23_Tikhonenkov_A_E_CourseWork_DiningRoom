@{
    ViewData["Title"] = "Home Page";
}
<head>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
    <style>
        .main {
            background-repeat: no-repeat;
            background-size: cover;
            width: 100%;
            display: flex;
            align-items: center;
            margin-top: 124px;
        }
        .intro_wrapper{
            display: flex;
            justify-content: right;
            min-height: 240px;
        }
        .intro_block {
            width: 553px;
        }
        .intro_title {
            font-size: 60px;
            font-weight: 700;
            margin: 0 0 29px 0;
        }
        .intro_text {
            font-size: 20px;
            margin: 0;
        }
    </style>

<form method="post">
    <div class="main">
        <div class="container-fluid">
            <div class="intro_wrapper">
                <div class="intro_block">
                    <h1 class="intro_title">
                        Столовая "Рога и Копыта"
                    </h1>
                    <p class="intro_text"> 
                        УРАААА Я ЭТО СДЕЛАЛ
                    </p>
                </div>
            </div>
        </div>
    </div>
</form>
